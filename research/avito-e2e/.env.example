# Fill both values locally. Never paste the token into chat.
BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=0
TELEGRAM_PROXY=http://127.0.0.1:18080

# Optional DeepSeek extraction. Fill API key locally, then set ENABLED=1.
DEEPSEEK_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROXY=http://127.0.0.1:18080
DEEPSEEK_MAX_CALLS_PER_DAY=40
DEEPSEEK_MAX_CALLS_PER_RUN=3
